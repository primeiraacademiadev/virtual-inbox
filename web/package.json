{
  "name": "virtual-inbox-console",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "predev": "node ../scripts/sync-docs.mjs",
    "prebuild": "node ../scripts/sync-docs.mjs",
    "dev:https": "vite --host 127.0.0.1 --config vite.https.config.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "i18next": "^26.5.11",
    "react-i18next": "^17.1.9"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=24"
  }
}
