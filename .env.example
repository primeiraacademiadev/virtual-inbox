# Bind addresses (loopback by default)
HOST=127.0.0.1
PORT=3000
HTTPS_PORT=3443
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
SMTPS_PORT=2465
DEMO_PORT=3001
DEMO_HTTPS_PORT=3444
PUBLIC_HOST=localhost

# TLS_MODE: auto generates a local CA and signed server certificate with OpenSSL.
# external loads TLS_CERT_FILE and TLS_KEY_FILE; off disables TLS listeners.
TLS_MODE=auto
TLS_CERTIFICATES_DIR=./data/certificates
TLS_SERVER_NAMES=localhost,127.0.0.1
# TLS_CERT_FILE=/secure/certs/server.pem
# TLS_KEY_FILE=/secure/certs/server-key.pem
# ADMIN_TOKEN=replace-with-a-long-random-token

# Ephemeral resource and protocol quotas
MAX_SMTP_MESSAGE_BYTES=20971520
MAX_ATTACHMENT_BYTES=20971520
MAX_HTTP_BODY_BYTES=33554432
MAX_SMS_BODY_BYTES=65536
MAX_MESSAGE_BODY_CHARS=2097152
MAX_MESSAGE_COUNT=10000
MAX_STORED_BYTES=268435456
MAX_LOG_ENTRIES=2000
DEFAULT_INBOX_TTL_SECONDS=1800
MAX_INBOX_TTL_SECONDS=604800
OBSERVER_SESSION_TTL_SECONDS=3600
MAX_WAIT_TIMEOUT_MS=120000
MAX_CONNECTIONS=200
MAX_INBOX_COUNT=2000
MAX_OBSERVER_COUNT=500
MAX_ATTACHMENTS_PER_MESSAGE=20
NETWORK_SETTINGS_FILE=./data/network-settings.json
# Single-file imported certificate identity; stored with private key (never commit).
TLS_MANAGED_IDENTITY_FILE=./data/certificates/imported-identity.json
