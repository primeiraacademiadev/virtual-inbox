{
  "name": "virtual-inbox",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "build": "npm run build:server && npm run build:console",
    "test": "node --import tsx --test test/*.test.ts",
    "dev:console": "npm run dev --prefix web",
    "build:console": "npm run build --prefix web",
    "audit": "npm audit --audit-level=high && npm audit --prefix web --audit-level=high",
    "dev:console:https": "npm run dev:https --prefix web",
    "build:server": "tsc",
    "predev": "npm run build:console",
    "test:coverage": "c8 --reporter=lcov --reporter=text node --import tsx --test test/*.test.ts",
    "test:integration": "node testing/scripts/run-managed.mjs test:protocols",
    "test:e2e": "node testing/scripts/run-managed.mjs test:e2e",
    "test:all": "node testing/scripts/run-managed.mjs test:all"
  },
  "dependencies": {
    "smtp-server": "^3.19.23",
    "postal-mime": "^4.0.11",
    "nodemailer": "^10.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/smtp-server": "^3.5.13",
    "typescript": "^7.0.2",
    "tsx": "^4.23.15",
    "c8": "^12.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
