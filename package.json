{
  "name": "virtual-inbox",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "dev:console": "npm run dev --prefix web",
    "build:console": "npm run build --prefix web",
    "audit": "npm audit --audit-level=high && npm audit --prefix web --audit-level=high"
  },
  "dependencies": {
    "smtp-server": "^3.19.23",
    "postal-mime": "^4.0.11",
    "nodemailer": "^10.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/smtp-server": "^3.5.13",
    "typescript": "^7.0.2",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": ">=24"
  }
}
