{
  "name": "virtual-inbox",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "dev:console": "npm run dev --prefix web",
    "build:console": "npm run build --prefix web",
    "audit": "npm audit --audit-level=high && npm audit --prefix web --audit-level=high"
  },
  "dependencies": {
    "smtp-server": "^3.19.23",
    "postal-mime": "^4.0.11",
    "nodemailer": "^10.2.0",
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/smtp-server": "^3.5.13",
    "typescript": "^6.0.0",
    "tsx": "^4.23.15",
    "@types/node-forge": "^1.3.11"
  },
  "engines": {
    "node": ">=24"
  }
}
